# Kaliza Backend — Environment Configuration
# Copy to .env and fill in values. Supabase values are pre-populated by Bolt.

# --- Supabase (pre-populated) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Auth ---
JWT_SECRET=change-me-in-production

# --- Meta WhatsApp (Kaliza control channel) ---
# Placeholder — replace with real Meta credentials when available
META_APP_ID=placeholder_meta_app_id
META_APP_SECRET=placeholder_meta_app_secret
META_WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
META_WHATSAPP_VERIFY_TOKEN=placeholder_verify_token

# --- Google Connector ---
# Placeholder — replace with real Google OAuth credentials when available
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# --- Daytona ---
# Placeholder — replace with real Daytona credentials when available
DAYTONA_API_URL=https://app.daytona.ai
DAYTONA_API_KEY=placeholder_daytona_api_key

# --- AI Model Providers ---
# Placeholder — replace with real provider keys when available
OPENAI_API_KEY=placeholder_openai_api_key
ANTHROPIC_API_KEY=placeholder_anthropic_api_key

# --- Object Storage (S3-compatible) ---
# Placeholder — replace with real storage credentials when available
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=kaliza-files
S3_REGION=auto

# --- Encryption ---
# Used for encrypting OAuth tokens at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=placeholder_encryption_key_generate_one_in_production
