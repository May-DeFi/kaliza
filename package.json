{
  "name": "kaliza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kaliza — AI-powered opportunity discovery and execution platform backend",
  "main": "dist/api/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api/index.js",
    "dev": "tsx watch src/api/index.ts",
